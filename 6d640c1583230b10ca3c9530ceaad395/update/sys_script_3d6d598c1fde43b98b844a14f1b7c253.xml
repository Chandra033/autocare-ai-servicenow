        <script><![CDATA[/**
 * Business Rule script: Generate Service Summary
 *
 * Triggers asynchronously after a Service Outcome update when
 * final_status changes to 'completed'. Calls ServiceSummaryGenerator
 * to collect verified record data and generate the summary via the
 * GenAI integration layer.
 *
 * Passes only the Service Outcome sys_id — the Script Include
 * handles all data collection and GenAI invocation.
 */
var generator = new ServiceSummaryGenerator();
var result = generator.generateSummary(current.getUniqueValue());

if (!result.success) {
    gs.warn('Generate Service Summary: Failed for ' + current.getUniqueValue() + ' — ' + result.error);
}
]]></script>
